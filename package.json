{
  "name": "fiscaliza-ai-camara-federal-app",
  "version": "1.0.0",
  "slogan": "An app to monitor the activities of the Brazilian Chamber of Deputies",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "setup-env": "node scripts/setup-env.js",
    "start": "npm run setup-env && expo start",
    "android": "npm run setup-env && expo start --android",
    "ios": "npm run setup-env && expo start --ios",
    "web": "npm run setup-env && expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-vector-icons/material-design-icons": "^12.4.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "expo": "~54.0.31",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-router": "^6.0.22",
    "expo-secure-store": "~15.0.8",
    "lucide-react-native": "^0.562.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.7.2"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "~0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react-native-network-info": "^5.2.2",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
